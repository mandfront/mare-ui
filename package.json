{
  "name": "mare-ui",
  "private": true,
  "description": "Maré UI — design system multi-marca: tokens e componentes React acessíveis.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint:root && pnpm registry:check && turbo run lint typecheck test build && pnpm check:packages",
    "prepare": "lefthook install",
    "lint:root": "eslint scripts",
    "check:packages": "pnpm --filter \"./packages/*\" exec publint --strict",
    "registry": "node scripts/build-registry.js",
    "registry:check": "node scripts/build-registry.js --check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
