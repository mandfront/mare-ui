{
  "name": "@mare-ui/react",
  "version": "0.0.0",
  "private": true,
  "description": "Componentes React acessíveis do Maré UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.6",
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mare-ui/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  }
}
