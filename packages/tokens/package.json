{
  "name": "@mare-ui/tokens",
  "version": "0.0.0",
  "description": "Design tokens do Maré UI (cores, tipografia, espaçamento, raios) no formato W3C.",
  "license": "MIT",
  "author": "Amanda Caraça",
  "homepage": "https://docs-rosy-two-80.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandfront/mare-ui.git",
    "directory": "packages/tokens"
  },
  "bugs": "https://github.com/mandfront/mare-ui/issues",
  "keywords": [
    "design-tokens",
    "design-system",
    "dtcg",
    "css-variables",
    "tailwindcss",
    "theme"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "style-dictionary": "^5.8.0",
    "vitest": "^5.1.0"
  }
}
